{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arena.invalid/schemas/control-v1.schema.json",
  "title": "Arena loopback control protocol version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "run_id", "sequence", "type", "payload"],
  "properties": {
    "protocol": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$", "not": { "pattern": "[\\r\\n\\u2028\\u2029]" } },
    "sequence": { "$ref": "#/$defs/positive_u64" },
    "correlation": { "$ref": "#/$defs/positive_u64" },
    "type": { "enum": ["hello", "ready", "heartbeat", "build_progress", "prepare", "start", "abort", "public_clock", "public_state", "elimination", "civilization_state", "outcome", "metrics", "ack", "error", "checkpoint", "checkpoint_written", "damage"] },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "enum": ["ready", "ack"] } }, "required": ["type"] },
      "then": { "required": ["correlation"] }
    },
    {
      "oneOf": [
        { "properties": { "type": { "const": "hello" }, "payload": { "$ref": "#/$defs/hello_payload" } }, "required": ["type", "payload"] },
        { "properties": { "type": { "const": "ready" }, "payload": { "$ref": "#/$defs/ready_payload" } }, "required": ["type", "payload"] },
        { "properties": { "type": { "const": "heartbeat" }, "payload": { "$ref": "#/$defs/empty_payload" } }, "required": ["type", "payload"] },
        { "properties": { "type": { "const": "build_progress" }, "payload": { "$ref": "#/$defs/build_progress_payload" } }, "required": ["type", "payload"] },
        { "properties": { "type": { "const": "prepare" }, "payload": { "$ref": "#/$defs/prepare_payload" } }, "required": ["type", "payload"] },
        { "properties": { "type": { "const": "start" }, "payload": { "$ref": "#/$defs/empty_payload" } }, "required": ["type", "payload"] },
        { "properties": { "type": { "const": "abort" }, "payload": { "$ref": "#/$defs/abort_payload" } }, "required": ["type", "payload"] },
        { "properties": { "type": { "const": "public_clock" }, "payload": { "$ref": "#/$defs/public_clock_payload" } }, "required": ["type", "payload"] },
        { "properties": { "type": { "const": "public_state" }, "payload": { "$ref": "#/$defs/public_state_payload" } }, "required": ["type", "payload"] },
        { "properties": { "type": { "const": "elimination" }, "payload": { "$ref": "#/$defs/elimination_payload" } }, "required": ["type", "payload"] },
        { "properties": { "type": { "const": "civilization_state" }, "payload": { "$ref": "#/$defs/civilization_state_payload" } }, "required": ["type", "payload"] },
        { "properties": { "type": { "const": "outcome" }, "payload": { "$ref": "#/$defs/outcome_payload" } }, "required": ["type", "payload"] },
        { "properties": { "type": { "const": "metrics" }, "payload": { "$ref": "#/$defs/metrics_payload" } }, "required": ["type", "payload"] },
        { "properties": { "type": { "const": "ack" }, "payload": { "$ref": "#/$defs/empty_payload" } }, "required": ["type", "payload"] },
        { "properties": { "type": { "const": "error" }, "payload": { "$ref": "#/$defs/error_payload" } }, "required": ["type", "payload"] },
        { "properties": { "type": { "const": "damage" }, "payload": { "$ref": "#/$defs/damage_payload" } }, "required": ["type", "payload"] },
        { "properties": { "type": { "const": "checkpoint" }, "payload": { "$ref": "#/$defs/checkpoint_payload" } }, "required": ["type", "payload"] },
        { "properties": { "type": { "const": "checkpoint_written" }, "payload": { "$ref": "#/$defs/checkpoint_written_payload" } }, "required": ["type", "payload"] }
      ]
    }
  ],
  "$defs": {
    "u64": {
      "type": "string",
      "maxLength": 20,
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0][0-9]|1844674407370955161[0-5]|18446744073709551615)$",
      "not": { "pattern": "[\\r\\n\\u2028\\u2029]" }
    },
    "positive_u64": {
      "allOf": [
        { "$ref": "#/$defs/u64" },
        { "not": { "const": "0" } }
      ]
    },
    "capability": { "enum": ["hunger_games_v1", "civilization_v1", "hunger_games_roster_v2", "checkpoint_v1", "damage_events_v1", "tick_metrics_v1"] },
    "abort_reason": { "enum": ["operator", "lease_lost", "invalid_world", "protocol_error", "runtime_timeout"] },
    "tick": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "value"],
      "properties": {
        "domain": { "enum": ["countdown", "match"] },
        "value": { "$ref": "#/$defs/u64" }
      }
    },
    "match_tick": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "value"],
      "properties": {
        "domain": { "const": "match" },
        "value": { "$ref": "#/$defs/u64" }
      }
    },
    "seat": { "type": "integer", "minimum": 0, "maximum": 255 },
    "seat_list": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/seat" },
      "uniqueItems": true
    },
    "empty_payload": { "type": "object", "additionalProperties": false },
    "damage_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "entries"],
      "properties": {
        "at": { "$ref": "#/$defs/match_tick" },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2048,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["victim", "attacker", "cause", "amount", "attacker_is_competitor"],
            "properties": {
              "victim": { "$ref": "#/$defs/seat" },
              "attacker": { "oneOf": [{ "$ref": "#/$defs/seat" }, { "type": "null" }] },
              "cause": { "enum": ["melee", "projectile", "border", "fall", "fire", "starvation", "other"] },
              "amount": { "type": "number", "exclusiveMinimum": 0 },
              "attacker_is_competitor": { "type": "boolean" }
            }
          }
        }
      }
    },
    "checkpoint_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint_id", "epoch"],
      "properties": {
        "checkpoint_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" },
        "epoch": { "type": "integer", "minimum": 0, "maximum": 1000000 }
      }
    },
    "checkpoint_written_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint_id", "epoch", "match_tick", "digest", "byte_length"],
      "properties": {
        "checkpoint_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" },
        "epoch": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "match_tick": { "$ref": "#/$defs/u64" },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "byte_length": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "hello_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "capabilities"],
      "properties": {
        "token": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9_-]+$", "not": { "pattern": "[\\r\\n\\u2028\\u2029]" } },
        "capabilities": { "type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true, "items": { "$ref": "#/$defs/capability" } }
      }
    },
    "ready_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["server", "plugin", "capabilities"],
      "properties": {
        "server": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "minecraft_version", "protocol_version"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 128 },
            "version": { "type": "string", "minLength": 1, "maxLength": 128 },
            "minecraft_version": { "type": "string", "minLength": 1, "maxLength": 64 },
            "protocol_version": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
          }
        },
        "plugin": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 128 },
            "version": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        },
        "capabilities": { "type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true, "items": { "$ref": "#/$defs/capability" } }
      }
    },
    "build_progress_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "completed", "total"],
      "properties": {
        "stage": { "enum": ["validating", "preparing_world", "snapshotting"] },
        "completed": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "total": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "bot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "seat", "participant_id", "username", "offline_uuid"],
      "properties": {
        "kind": { "const": "bot" },
        "seat": { "type": "integer", "minimum": 0, "maximum": 5 },
        "participant_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$", "not": { "pattern": "[\\r\\n\\u2028\\u2029]" } },
        "username": { "type": "string", "minLength": 1, "maxLength": 16, "pattern": "^[A-Za-z0-9_]+$", "not": { "pattern": "[\\r\\n\\u2028\\u2029]" } },
        "offline_uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "not": { "pattern": "[\\r\\n\\u2028\\u2029]" } }
      }
    },
    "roster_competitor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "seat", "participant_id", "username", "offline_uuid"],
      "properties": {
        "kind": { "enum": ["bot", "external"] },
        "seat": { "$ref": "#/$defs/seat" },
        "participant_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$", "not": { "pattern": "[\\r\\n\\u2028\\u2029]" } },
        "username": { "type": "string", "minLength": 1, "maxLength": 16, "pattern": "^[A-Za-z0-9_]+$", "not": { "pattern": "[\\r\\n\\u2028\\u2029]" } },
        "offline_uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "not": { "pattern": "[\\r\\n\\u2028\\u2029]" } }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "external" } }, "required": ["kind"] },
          "then": {
            "properties": {
              "username": { "pattern": "^(?![Aa][Rr][Ee][Nn][Aa]([Bb][Oo][Tt]|[Ss][Pp][Ee][Cc]))[A-Za-z0-9_]{3,16}$" }
            }
          }
        }
      ]
    },
    "match_settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["countdown_ticks", "grace_ticks", "authoritative_max_ticks", "respawn", "block_breaking", "block_placing", "natural_mobs", "natural_random_ticks"],
      "properties": {
        "countdown_ticks": { "$ref": "#/$defs/u64" },
        "grace_ticks": { "$ref": "#/$defs/u64" },
        "authoritative_max_ticks": { "$ref": "#/$defs/positive_u64" },
        "respawn": { "type": "boolean" },
        "block_breaking": { "type": "boolean" },
        "block_placing": { "type": "boolean" },
        "natural_mobs": { "type": "boolean" },
        "natural_random_ticks": { "type": "boolean" }
      }
    },
    "border_settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial_diameter_blocks", "shrink_start_tick", "shrink_end_tick", "final_diameter_blocks"],
      "properties": {
        "initial_diameter_blocks": { "type": "number", "exclusiveMinimum": 0 },
        "shrink_start_tick": { "$ref": "#/$defs/u64" },
        "shrink_end_tick": { "$ref": "#/$defs/u64" },
        "final_diameter_blocks": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "civilization_match_settings": {
      "allOf": [
        { "$ref": "#/$defs/match_settings" },
        {
          "properties": {
            "grace_ticks": { "const": "2400" },
            "authoritative_max_ticks": { "const": "18000" },
            "respawn": { "const": false },
            "block_breaking": { "const": true },
            "block_placing": { "const": true }
          }
        }
      ]
    },
    "fixed_border_settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "diameter_blocks"],
      "properties": {
        "kind": { "const": "fixed" },
        "diameter_blocks": { "const": 192 }
      }
    },
    "block_position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
        "z": { "type": "integer", "minimum": 0 }
      }
    },
    "ember_faction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "members"],
      "properties": {
        "id": { "const": "ember" },
        "members": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            { "type": "object", "additionalProperties": false, "required": ["seat", "role"], "properties": { "seat": { "const": 0 }, "role": { "const": "gatherer_crafter" } } },
            { "type": "object", "additionalProperties": false, "required": ["seat", "role"], "properties": { "seat": { "const": 1 }, "role": { "const": "builder" } } },
            { "type": "object", "additionalProperties": false, "required": ["seat", "role"], "properties": { "seat": { "const": 2 }, "role": { "const": "defender_scout" } } }
          ],
          "items": false
        }
      }
    },
    "tide_faction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "members"],
      "properties": {
        "id": { "const": "tide" },
        "members": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            { "type": "object", "additionalProperties": false, "required": ["seat", "role"], "properties": { "seat": { "const": 3 }, "role": { "const": "gatherer_crafter" } } },
            { "type": "object", "additionalProperties": false, "required": ["seat", "role"], "properties": { "seat": { "const": 4 }, "role": { "const": "builder" } } },
            { "type": "object", "additionalProperties": false, "required": ["seat", "role"], "properties": { "seat": { "const": 5 }, "role": { "const": "defender_scout" } } }
          ],
          "items": false
        }
      }
    },
    "civilization_item_stack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item", "count"],
      "properties": {
        "item": { "enum": ["minecraft:bread", "minecraft:wooden_axe", "minecraft:wooden_pickaxe", "minecraft:wooden_sword"] },
        "count": { "type": "integer", "minimum": 1, "maximum": 64 }
      }
    },
    "civilization_factions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [{ "$ref": "#/$defs/ember_faction" }, { "$ref": "#/$defs/tide_faction" }],
      "items": false
    },
    "civilization_starting_kit": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        { "const": { "item": "minecraft:bread", "count": 4 } },
        { "const": { "item": "minecraft:wooden_axe", "count": 1 } },
        { "const": { "item": "minecraft:wooden_pickaxe", "count": 1 } },
        { "const": { "item": "minecraft:wooden_sword", "count": 1 } }
      ],
      "items": false
    },
    "capture_zone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max", "uncontested_ticks", "score_points_per_tick"],
      "properties": {
        "min": { "$ref": "#/$defs/block_position" },
        "max": { "$ref": "#/$defs/block_position" },
        "uncontested_ticks": { "const": 200 },
        "score_points_per_tick": { "const": 1 }
      }
    },
    "civilization_blueprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "anchors"],
      "properties": {
        "id": { "const": "oak-outpost-v1" },
        "anchors": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ember", "tide"],
          "properties": {
            "ember": {
              "type": "object",
              "additionalProperties": false,
              "required": ["position", "rotation_degrees"],
              "properties": { "position": { "$ref": "#/$defs/block_position" }, "rotation_degrees": { "const": 0 }
              }
            },
            "tide": {
              "type": "object",
              "additionalProperties": false,
              "required": ["position", "rotation_degrees"],
              "properties": { "position": { "$ref": "#/$defs/block_position" }, "rotation_degrees": { "const": 180 }
              }
            }
          }
        }
      }
    },
    "civilization_settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factions", "starting_kit", "capture_zone", "blueprint"],
      "properties": {
        "factions": { "$ref": "#/$defs/civilization_factions" },
        "starting_kit": { "$ref": "#/$defs/civilization_starting_kit" },
        "capture_zone": { "$ref": "#/$defs/capture_zone" },
        "blueprint": { "$ref": "#/$defs/civilization_blueprint" }
      }
    },
    "prepare_payload": {
      "oneOf": [
        { "$ref": "#/$defs/hunger_games_prepare_payload" },
        { "$ref": "#/$defs/hunger_games_roster_v2_prepare_payload" },
        { "$ref": "#/$defs/civilization_prepare_payload" }
      ]
    },
    "hunger_games_prepare_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["map_semantic_id", "scenario_semantic_id", "seed", "mode", "settings", "roster"],
      "properties": {
        "map_semantic_id": { "type": "string", "pattern": "^[0-9a-f]{64}$", "not": { "pattern": "[\\r\\n\\u2028\\u2029]" } },
        "scenario_semantic_id": { "type": "string", "pattern": "^[0-9a-f]{64}$", "not": { "pattern": "[\\r\\n\\u2028\\u2029]" } },
        "seed": { "$ref": "#/$defs/u64" },
        "mode": { "const": "hunger_games" },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["match", "border"],
          "properties": {
            "match": { "$ref": "#/$defs/match_settings" },
            "border": { "$ref": "#/$defs/border_settings" }
          }
        },
        "roster": { "$ref": "#/$defs/bot_roster" }
      }
    },
    "prepare_rules": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "version", "edit_radius_blocks", "max_block_edits_per_seat"],
          "properties": {
            "kind": { "const": "frontier_survival" },
            "version": { "const": 1 },
            "edit_radius_blocks": { "type": "integer", "minimum": 16, "maximum": 512 },
            "max_block_edits_per_seat": { "type": "integer", "minimum": 1, "maximum": 100000 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "version", "squads"],
          "properties": {
            "kind": { "const": "squads" },
            "version": { "const": 1 },
            "squads": {
              "type": "array",
              "minItems": 2,
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "seats"],
                "properties": {
                  "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,15}$" },
                  "seats": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/seat" } }
                }
              }
            }
          }
        }
      ]
    },
    "hunger_games_roster_v2_prepare_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["map_semantic_id", "scenario_semantic_id", "seed", "mode", "roster_version", "settings", "roster"],
      "properties": {
        "map_semantic_id": { "type": "string", "pattern": "^[0-9a-f]{64}$", "not": { "pattern": "[\\r\\n\\u2028\\u2029]" } },
        "scenario_semantic_id": { "type": "string", "pattern": "^[0-9a-f]{64}$", "not": { "pattern": "[\\r\\n\\u2028\\u2029]" } },
        "seed": { "$ref": "#/$defs/u64" },
        "mode": { "const": "hunger_games" },
        "roster_version": { "const": 2 },
        "rules": { "$ref": "#/$defs/prepare_rules" },
        "damage_events": { "const": true },
        "resume": {
          "type": "object",
          "additionalProperties": false,
          "required": ["checkpoint_digest", "epoch"],
          "properties": {
            "checkpoint_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "epoch": { "type": "integer", "minimum": 1, "maximum": 1000000 }
          }
        },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["match", "border"],
          "properties": {
            "match": { "$ref": "#/$defs/match_settings" },
            "border": { "$ref": "#/$defs/border_settings" }
          }
        },
        "roster": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/roster_competitor" } }
      }
    },
    "civilization_prepare_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["map_semantic_id", "scenario_semantic_id", "seed", "mode", "settings", "roster"],
      "properties": {
        "map_semantic_id": { "type": "string", "pattern": "^[0-9a-f]{64}$", "not": { "pattern": "[\\r\\n\\u2028\\u2029]" } },
        "scenario_semantic_id": { "type": "string", "pattern": "^[0-9a-f]{64}$", "not": { "pattern": "[\\r\\n\\u2028\\u2029]" } },
        "seed": { "$ref": "#/$defs/u64" },
        "mode": { "const": "civilization" },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["match", "border", "civilization"],
          "properties": {
            "match": { "$ref": "#/$defs/civilization_match_settings" },
            "border": { "$ref": "#/$defs/fixed_border_settings" },
            "civilization": { "$ref": "#/$defs/civilization_settings" }
          }
        },
        "roster": { "$ref": "#/$defs/civilization_bot_roster" }
      }
    },
    "bot_roster": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/bot" }
    },
    "civilization_bot_roster": {
      "allOf": [
        { "$ref": "#/$defs/bot_roster" },
        { "minItems": 6, "maxItems": 6 },
        { "contains": { "properties": { "seat": { "const": 0 } }, "required": ["seat"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "seat": { "const": 1 } }, "required": ["seat"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "seat": { "const": 2 } }, "required": ["seat"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "seat": { "const": 3 } }, "required": ["seat"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "seat": { "const": 4 } }, "required": ["seat"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "seat": { "const": 5 } }, "required": ["seat"] }, "minContains": 1, "maxContains": 1 }
      ]
    },
    "abort_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": { "reason": { "$ref": "#/$defs/abort_reason" } }
    },
    "public_clock_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "tick", "border_diameter_blocks"],
      "properties": {
        "phase": { "enum": ["waiting", "countdown", "grace", "active", "finished", "aborted"] },
        "tick": { "oneOf": [{ "$ref": "#/$defs/tick" }, { "type": "null" }] },
        "border_diameter_blocks": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "public_state_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "alive_seats"],
      "properties": {
        "at": { "$ref": "#/$defs/tick" },
        "alive_seats": { "$ref": "#/$defs/seat_list" }
      }
    },
    "faction_id": { "enum": ["ember", "tide"] },
    "faction_scores": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        { "type": "object", "additionalProperties": false, "required": ["faction_id", "points"], "properties": { "faction_id": { "const": "ember" }, "points": { "$ref": "#/$defs/u64" } } },
        { "type": "object", "additionalProperties": false, "required": ["faction_id", "points"], "properties": { "faction_id": { "const": "tide" }, "points": { "$ref": "#/$defs/u64" } } }
      ],
      "items": false
    },
    "civilization_state_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "occupants", "owner_faction", "challenger_faction", "capture_progress_ticks", "scores"],
      "properties": {
        "at": { "$ref": "#/$defs/match_tick" },
        "occupants": { "$ref": "#/$defs/seat_list" },
        "owner_faction": { "oneOf": [{ "$ref": "#/$defs/faction_id" }, { "type": "null" }] },
        "challenger_faction": { "oneOf": [{ "$ref": "#/$defs/faction_id" }, { "type": "null" }] },
        "capture_progress_ticks": { "$ref": "#/$defs/u64" },
        "scores": { "$ref": "#/$defs/faction_scores" }
      }
    },
    "elimination_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "eliminations"],
      "properties": {
        "at": { "$ref": "#/$defs/tick" },
        "eliminations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["seat", "cause"],
            "properties": {
              "seat": { "$ref": "#/$defs/seat" },
              "cause": { "enum": ["death", "disconnect"] }
            }
          }
        }
      }
    },
    "winner_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "winner_seat", "survivors", "at"],
      "properties": {
        "kind": { "const": "winner" },
        "winner_seat": { "$ref": "#/$defs/seat" },
        "survivors": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/seat" } },
        "at": { "$ref": "#/$defs/tick" }
      }
    },
    "faction_winner_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "winner_faction_id", "reason", "scores", "survivors", "at"],
      "properties": {
        "kind": { "const": "faction_winner" },
        "winner_faction_id": { "$ref": "#/$defs/faction_id" },
        "reason": { "enum": ["elimination", "tick_limit"] },
        "scores": { "$ref": "#/$defs/faction_scores" },
        "survivors": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "$ref": "#/$defs/seat" }, "uniqueItems": true },
        "at": { "$ref": "#/$defs/match_tick" }
      }
    },
    "draw_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason", "survivors", "at"],
      "properties": {
        "kind": { "const": "draw" },
        "reason": { "enum": ["no_survivors", "tick_limit"] },
        "survivors": { "$ref": "#/$defs/seat_list" },
        "at": { "$ref": "#/$defs/tick" }
      }
    },
    "civilization_draw_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason", "scores", "survivors", "at"],
      "properties": {
        "kind": { "const": "draw" },
        "reason": { "enum": ["no_survivors", "tick_limit"] },
        "scores": { "$ref": "#/$defs/faction_scores" },
        "survivors": { "$ref": "#/$defs/seat_list" },
        "at": { "$ref": "#/$defs/match_tick" }
      }
    },
    "abort_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason", "survivors", "at"],
      "properties": {
        "kind": { "const": "abort" },
        "reason": { "$ref": "#/$defs/abort_reason" },
        "survivors": { "$ref": "#/$defs/seat_list" },
        "at": { "oneOf": [{ "$ref": "#/$defs/tick" }, { "type": "null" }] }
      }
    },
    "outcome_payload": {
      "oneOf": [
        { "$ref": "#/$defs/winner_outcome" },
        { "$ref": "#/$defs/faction_winner_outcome" },
        { "$ref": "#/$defs/draw_outcome" },
        { "$ref": "#/$defs/civilization_draw_outcome" },
        { "$ref": "#/$defs/abort_outcome" }
      ]
    },
    "metrics_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["server_tick_duration_micros", "critical_queue_depth", "dropped_optional_metrics"],
      "properties": {
        "server_tick_duration_micros": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "critical_queue_depth": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "dropped_optional_metrics": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "tick_durations_micros": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        }
      }
    },
    "error_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "enum": ["authentication_failed", "unsupported_capability", "invalid_command", "invalid_state", "invalid_world", "internal"] },
        "message": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    }
  }
}
